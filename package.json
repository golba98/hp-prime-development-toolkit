{
  "name": "hpdev-development",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "test:npm": "node tests/packaging/npm-install.mjs",
    "test:release": "node --test tests/packaging/release.test.mjs tests/packaging/project-files.test.mjs",
    "test:browser": "playwright test --config tests/browser/playwright.config.mjs",
